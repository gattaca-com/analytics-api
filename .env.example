# Read-only Postgres user (ethereum warehouse)
DB_HOST=100.97.146.86
DB_PORT=5432
DB_NAME=ethereum
DB_USER=api_ro
DB_PASSWORD=

# Connection pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# Query guards
MAX_LIMIT=1000
DEFAULT_LIMIT=100
# Max width of a start/end timestamp range, in seconds (default 6h)
MAX_RANGE_SECONDS=21600
# Tighter range cap for /bid-submissions (huge hypertable), in seconds
BID_SUBMISSION_MAX_RANGE_SECONDS=3600
# Statement timeout per query, in seconds
STATEMENT_TIMEOUT_SECONDS=15

# Per-client-IP rate limits (requests/minute, 0 = disabled)
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_HEAVY_PER_MINUTE=20
